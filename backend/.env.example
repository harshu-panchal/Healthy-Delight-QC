# Server Configuration
NODE_ENV=development
PORT=7000
MONGODB_URI=your_mongodb_connection_string
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Authentication & JWT
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret
JWT_SECRET=your_jwt_secret

# Cloudinary Storage
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Default Admin Credentials
DEFAULT_ADMIN_MOBILE=9876543210
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_ROLE=Super Admin
DEFAULT_OTP=9999

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OTP Configuration
TWOFACTOR_API_KEY=your_2factor_api_key
OTP_EXPIRY_MINUTES=5
OTP_PROVIDER=SMS_INDIA_HUB
USE_MOCK_OTP=true
USE_REAL_OTP=false

# SMS India Hub Configuration
APP_NAME=Healthy Delight
SMS_OTP_MESSAGE_TEMPLATE=Welcome to the {app} powered by Appzeto.Your OTP for registration is {otp}.BGADEC
SMS_INDIA_HUB_USERNAME=your_sms_username
SMS_INDIA_HUB_API_KEY=your_sms_api_key
SMS_INDIA_HUB_SENDER_ID=your_sender_id
SMS_INDIA_HUB_DLT_TEMPLATE_ID=your_dlt_template_id

# Firebase Service Account (JSON string)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'
